{
    "name": "save-editors-layout",
    "displayName": "Save Editors Layout",
    "description": "save opened editors layout",
    "version": "3.0.0",
    "publisher": "ctf0",
    "repository": "https://github.com/ctf0/vscode-save-editor-layout",
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/main",
    "contributes": {
        "configuration": {
            "title": "Editor Layout",
            "type": "object",
            "properties": {
                "saveEditorLayout.list": {
                    "type": "array",
                    "default": [],
                    "description": "Saved layout snapshots. Only supported in workspace settings.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "file": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            }
                        }
                    }
                },
                "saveEditorLayout.autoApplyLayoutTemplate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically apply the saved layout template to every new workspace"
                },
                "saveEditorLayout.autoApplyDelay": {
                    "type": "number",
                    "default": 10,
                    "minimum": 7,
                    "description": "How long to wait after startup before the auto-apply flow checks the workspace state and asks for confirmation."
                },
                "saveEditorLayout.saveMode": {
                    "type": "string",
                    "default": "quick",
                    "enum": [
                        "quick",
                        "accurate",
                        "ask"
                    ],
                    "enumDescriptions": [
                        "Save immediately without restarting. Panels and auxiliary bar positions wont be captured, but fast and non-intrusive.",
                        "Restart VS Code to capture the exact current layout, then save. Always accurate but interrupts your workflow.",
                        "Ask which mode to use each time you save a snapshot."
                    ],
                    "description": "How to save layout snapshots."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "editor-layouts",
                    "title": "Editor Layout",
                    "icon": "$(editor-layout)"
                }
            ]
        },
        "views": {
            "editor-layouts": [
                {
                    "id": "layouts_list",
                    "name": "List",
                    "icon": "$(editor-layout)"
                }
            ]
        },
        "commands": [
            {
                "command": "editorLayout.saveSnapshot",
                "title": "Save A Snapshot",
                "category": "Editor Layout",
                "icon": "$(device-camera)"
            },
            {
                "command": "editorLayout.restoreSnapshot",
                "title": "Restore Snapshot",
                "category": "Editor Layout",
                "when": "false"
            },
            {
                "command": "editorLayout.deleteSnapshot",
                "title": "Delete Snapshot",
                "category": "Editor Layout",
                "icon": "$(trash)",
                "when": "false"
            },
            {
                "command": "editorLayout.saveTemplate",
                "title": "Save Layout as Template",
                "category": "Editor Layout",
                "icon": "$(mirror)",
                "when": "!editorLayout.hasTemplate"
            },
            {
                "command": "editorLayout.updateTemplate",
                "title": "Update Layout Template",
                "category": "Editor Layout",
                "icon": "$(replace)",
                "when": "editorLayout.hasTemplate"
            },
            {
                "command": "editorLayout.applyTemplate",
                "title": "Apply Layout Template",
                "category": "Editor Layout",
                "icon": "$(wand)",
                "when": "editorLayout.hasTemplate"
            },
            {
                "command": "editorLayout.shareTemplate",
                "title": "Export Layout Template",
                "category": "Editor Layout",
                "icon": "$(archive)",
                "when": "editorLayout.hasTemplate"
            },
            {
                "command": "editorLayout.importTemplate",
                "title": "Import Layout Template",
                "category": "Editor Layout",
                "icon": "$(plug)"
            },
            {
                "command": "editorLayout.refresh",
                "title": "Refresh",
                "category": "Editor Layout",
                "icon": "$(refresh)",
                "when": "false"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "editorLayout.saveSnapshot",
                    "when": "view == layouts_list",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.saveTemplate",
                    "when": "view == layouts_list && !editorLayout.hasTemplate",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.updateTemplate",
                    "when": "view == layouts_list && editorLayout.hasTemplate",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.applyTemplate",
                    "when": "view == layouts_list && editorLayout.hasTemplate",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.shareTemplate",
                    "when": "view == layouts_list && editorLayout.hasTemplate",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.importTemplate",
                    "when": "view == layouts_list",
                    "group": "navigation"
                },
                {
                    "command": "editorLayout.refresh",
                    "when": "view == layouts_list",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "editorLayout.deleteSnapshot",
                    "when": "view == layouts_list && viewItem == snapshot",
                    "group": "inline"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --pure:console.log --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "npm run esbuild",
        "typecheck": "tsc --noEmit",
        "test": "node --test --import ./test/helpers/loader.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.110.0",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2"
    }
}
